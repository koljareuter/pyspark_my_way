      " 871  2026-08-22    02-49-59.379    19   1.4610   spec     —       —         0.0          \n",
      " 872  2026-08-22    02-49-59.379    20   1.4510   spec     —       —         0.0          \n",
      " 873  2026-08-22    02-49-59.379    21   1.4540   spec     —       —         0.0          \n",
      " 874  2026-08-22    02-49-59.379    22   1.4570  cluster     —       —         0.0          \n",
      " 875  2026-08-22    02-49-59.379    23   1.4600   spec     —       —         0.0          \n",
      " 876  2026-08-22    02-49-59.379    24   1.4570  cluster     —       —         0.0          \n",
      " 877  2026-08-22    04-09-10.767     1   1.4550   spec     —       —         0.0          \n",
      " 878  2026-08-22    04-09-10.767     2   1.4610   spec     —       —         0.0          \n",
      " 879  2026-08-22    04-09-10.767     3   1.4520   spec     —       —         0.0          \n",
      " 880  2026-08-22    04-09-10.767     5   1.4559   spec     —       —         0.0          \n",
      " 881  2026-08-22    04-09-10.767     7   1.4502   spec     —       —         0.0          \n",
      " 882  2026-08-22    04-09-10.767     8   1.4500   spec     —       —         0.0          \n",
