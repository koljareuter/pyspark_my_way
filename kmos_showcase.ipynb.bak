      " 884  2026-08-22    04-09-10.767    10   1.4480   spec     —       —         0.0          \n",
      " 885  2026-08-22    04-09-10.767    11   1.4570   spec     —       —         0.0          \n",
      " 886  2026-08-22    04-09-10.767    12   1.4569   spec     —       —         0.0          \n",
      " 887  2026-08-22    04-09-10.767    13   1.4570  cluster     —       —         0.0          \n",
      " 888  2026-08-22    04-09-10.767    14   1.4600   spec     —       —         0.0          \n",
      " 889  2026-08-22    04-09-10.767    16   1.4630   spec     —       —         0.0          \n",
      " 890  2026-08-22    04-09-10.767    18   1.4610   spec     —       —         0.0          \n",
      " 891  2026-08-22    04-09-10.767    19   1.4610   spec     —       —         0.0          \n",
      " 892  2026-08-22    04-09-10.767    20   1.4510   spec     —       —         0.0          \n",
      " 893  2026-08-22    04-09-10.767    21   1.4540   spec     —       —         0.0          \n",
      " 894  2026-08-22    04-09-10.767    22   1.4570  cluster     —       —         0.0          \n",
      " 895  2026-08-22    04-09-10.767    23   1.4600   spec     —       —         0.0          \n",
      " 896  2026-08-22    04-09-10.767    24   1.4570  cluster     —       —         0.0          \n"
     ]
