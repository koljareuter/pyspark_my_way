   "source": [
    "## Full-band spectra\n",
    "\n",
    "Full wavelength range for the top Hα detections.\n",
    "Individual exposures in grey; stacked median coloured.\n",
    "Vertical dashed lines = emission lines at catalogue redshift.\n",
    "Grey shading = atmospheric absorption bands."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "a3733a59",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1560x1872 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved → kmos_showcase_fullspec.pdf\n"
     ]
    }
   ],
   "source": [
    "_ATMOS = [\n",
    "    (0.685, 0.695, 'O2 B'), (0.715, 0.735, 'H2O'), (0.758, 0.772, 'O2 A'),\n",
    "    (0.805, 0.840, 'H2O'), (0.880, 0.990, 'H2O'),\n",
    "    (1.060, 1.110, 'H2O'), (1.130, 1.160, 'H2O'), (1.270, 1.320, 'H2O'),\n",
    "]\n",
    "\n",
    "def _shade_atmos(ax, wlo_um, whi_um):\n",
    "    for lo, hi, _ in _ATMOS:\n",
    "        if hi < wlo_um or lo > whi_um: continue\n",
    "        ax.axvspan(max(lo, wlo_um) * 1e4, min(hi, whi_um) * 1e4,\n",
    "                   alpha=0.09, color='#888', lw=0, zorder=0)\n",
    "\n",
    "# ── telluric-corrected OBs only (Feb 2026 onwards) ────────────────────────────\n",
    "TELL_FROM = '2026-02'\n",
    "\n",
    "show_fs = [\n",
    "    e for e in all_entries\n",
    "    if e.get('ob_date', '') >= TELL_FROM\n",
    "    and np.isfinite(e.get('snr', np.nan))\n",
    "    and e['snr'] >= SNR_MIN\n",
    "    and not e.get('fallback', False)\n",
    "][:TOP_DETAIL]\n",
    "\n",
    "if not show_fs:\n",
    "    total_tc = sum(1 for e in all_entries if e.get('ob_date', '') >= TELL_FROM)\n",
    "    print(f\"No telluric-corrected detections (Hα SNR ≥ {SNR_MIN}) found.\")\n",
    "    print(f\"  Telluric-corrected IFUs in all_entries: {total_tc}\")\n",
    "    print(f\"  (Re-run sc-rank to pick up any newly downloaded Feb–Aug OBs.)\")\n",
    "else:\n",
    "    fig, axes = plt.subplots(len(show_fs), 1,\n",
    "                             figsize=(13, len(show_fs) * 2.6),\n",
    "                             constrained_layout=True)\n",
    "    if len(show_fs) == 1:\n",
    "        axes = [axes]\n",
    "    fig.suptitle(\n",
    "        f\"Full-band spectra — top {len(show_fs)} Hα detections  \"\n",
    "        f\"[telluric-corrected, Feb 2026–]\",\n",
    "        fontsize=11, fontweight=\"bold\", y=1.002,\n",
    "    )\n",
    "    for ax, e, color in zip(axes, show_fs, PALETTE):\n",
    "        wave, z = e[\"wave\"], e[\"z\"]\n",
    "        wlo_um, whi_um = float(wave.min()), float(wave.max())\n",
    "\n",
    "        for s in e[\"spectra\"]:\n",
    "            ax.plot(wave * 1e4, s, color=\"#d0d0d0\", lw=0.35, alpha=0.5, zorder=1)\n",
    "        ax.plot(wave * 1e4, e[\"med\"], color=color, lw=1.6, zorder=3)\n",
    "        ax.axhline(0, color=\"#aaa\", lw=0.5, zorder=0)\n",
    "        _shade_atmos(ax, wlo_um, whi_um)\n",
    "\n",
    "        for lname, lrest in EMISSION_LINES.items():\n",
    "            lobs = lrest * (1 + z)\n",
    "            lc = LINE_COLORS.get(lname, \"#888888\")\n",
    "            if wlo_um <= lobs <= whi_um:\n",
    "                ax.axvline(lobs * 1e4, color=lc, lw=1.0, ls=\"--\", alpha=0.75, zorder=2)\n",
    "                ax.text(lobs * 1e4, 0.97, lname,\n",
    "                        transform=ax.get_xaxis_transform(),\n",
    "                        rotation=90, ha=\"right\", va=\"top\", fontsize=6.5, color=lc,\n",
    "                        bbox=dict(fc=\"white\", ec=\"none\", alpha=0.6, pad=1))\n",
    "\n",
    "        med_ok = e[\"med\"][np.isfinite(e[\"med\"])]\n",
    "        if med_ok.size:\n",
    "            ylo = np.nanpercentile(med_ok, 2)\n",
    "            yhi = np.nanmax(med_ok)\n",
    "            pad = 0.12 * max(yhi - ylo, 0)\n",
    "            ax.set_ylim(ylo - pad, yhi + pad)\n",
    "\n",
    "        ax.set_xlim(wlo_um * 1e4, whi_um * 1e4)\n",
    "        ax.set_xlabel(r\"$\\lambda_{\\rm obs}$  (Å)\", fontsize=8)\n",
    "        ax.set_ylabel(\"flux (norm.)\", fontsize=8)\n",
    "        ax.tick_params(labelsize=7)\n",
    "        ax.set_title(\n",
    "            f\"IFU {e['ifu']}  ·  {e['ob_date']}  ·  z={z:.4f}  ·  \"\n",
    "            f\"Hα SNR={e['snr']:.1f}  ·  N={e['n_exp']} exp  [telluric corr.]\",\n",
    "            fontsize=8, pad=4,\n",
    "        )\n",
    "\n",
    "    plt.savefig(\"kmos_showcase_fullspec.pdf\", bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "    print(\"Saved → kmos_showcase_fullspec.pdf\")\n"
   ]
  }
 ],
